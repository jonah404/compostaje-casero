rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App de dos personas: solo estas cuentas de Google. Si cambia la lista,
    // actualizar también CORREOS_AUTORIZADOS en public/public/historial.js.
    function autorizado() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['jonahlalvarez@gmail.com', 'mavidiaz092@gmail.com'];
    }

    // Colecciones del tracker: cada alta/edición declara su autor en _by.
    match /{col}/{id} {
      allow read: if autorizado() && col in ['sistemas', 'revolcadas', 'plantas', 'registroPlantas', 'pecera', 'registroPecera', 'clima'];
      allow create, update: if autorizado()
        && col in ['sistemas', 'revolcadas', 'plantas', 'registroPlantas', 'pecera', 'registroPecera', 'clima']
        && request.resource.data._by.uid == request.auth.uid;
      allow delete: if autorizado()
        && col in ['sistemas', 'revolcadas', 'plantas', 'registroPlantas', 'pecera', 'registroPecera', 'clima'];
    }

    // Historial de cambios: solo se crea (nunca se edita ni se borra) y con el autor real.
    match /historial/{id} {
      allow read: if autorizado();
      allow create: if autorizado() && request.resource.data.by.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
